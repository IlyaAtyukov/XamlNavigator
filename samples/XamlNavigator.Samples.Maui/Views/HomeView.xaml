<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:XamlNavigator.Samples.ViewModels;assembly=XamlNavigator.Samples.Shared"
             x:Class="XamlNavigator.Samples.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="720" HorizontalOptions="Start">
            <Label Text="XamlNavigator — .NET MAUI Sample" FontSize="24" FontAttributes="Bold" />
            <Label Text="On the left is the menu: &quot;Home&quot; and &quot;About&quot; are regular screens declared with [ChildOf], while &quot;Categories&quot;, &quot;Products&quot;, and &quot;Showcase&quot; are defined in data and generated by the navigator."
                   TextColor="{StaticResource TextMuted}" LineBreakMode="WordWrap" />

            <Border Padding="16,12" StrokeThickness="1" Stroke="#DDE0EA" StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource Surface}">
                <Label Text="{Binding Summary}" FontSize="15" LineBreakMode="WordWrap" />
            </Border>

            <Label Text="Navigation with back history" FontSize="16" FontAttributes="Bold" Margin="0,8,0,0" />
            <FlexLayout Wrap="Wrap" JustifyContent="Start">
                <Button Text="📦 Products — table" Command="{Binding OpenProductsCommand}" Margin="0,0,10,10" FlexLayout.Shrink="0" />
                <Button Text="🛍 Showcase — cards" Command="{Binding OpenShowcaseCommand}" Margin="0,0,10,10" FlexLayout.Shrink="0" />
                <Button Text="＋ New product" Command="{Binding AddProductCommand}" Margin="0,0,10,10" FlexLayout.Shrink="0" />
                <Button Text="ℹ About" Command="{Binding AboutCommand}" Margin="0,0,10,10" FlexLayout.Shrink="0" />
            </FlexLayout>
            <Label Text="After you navigate away, the &quot;‹ Back&quot; button in the header (and the hardware Back button on Android) brings you back here."
                   FontSize="12" TextColor="{StaticResource TextMuted}" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>

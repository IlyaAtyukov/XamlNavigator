<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:XamlNavigator.Samples.ViewModels;assembly=XamlNavigator.Samples.Shared"
             x:Class="XamlNavigator.Samples.Views.AboutView"
             x:DataType="vm:AboutViewModel">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="720" HorizontalOptions="Start">
            <Label Text="About" FontSize="24" FontAttributes="Bold" />
            <Label Text="{Binding Text}" FontSize="15" LineBreakMode="WordWrap" />
            <Label Text="{Binding CameFrom}" FontSize="13" TextColor="{StaticResource TextMuted}" />
            <Button Text="‹ Go back" Command="{Binding BackCommand}" HorizontalOptions="Start" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>

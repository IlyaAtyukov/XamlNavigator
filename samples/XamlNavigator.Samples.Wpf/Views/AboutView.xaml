<UserControl x:Class="XamlNavigator.Samples.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20" MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding CameFrom}" Foreground="{StaticResource AccentColor}" FontStyle="Italic" Margin="0,0,0,12"/>
        <Button Content="‹ Go back" Command="{Binding BackCommand}" HorizontalAlignment="Left"/>
    </StackPanel>
</UserControl>

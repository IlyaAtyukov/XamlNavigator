<UserControl x:Class="XamlNavigator.Samples.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20" MaxWidth="640" HorizontalAlignment="Left">
        <Border Background="{StaticResource SurfaceAltColor}" CornerRadius="10" Padding="18" Margin="0,0,0,16">
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="15"/>
        </Border>
        <TextBlock Text="The &quot;Categories&quot;, &quot;Products&quot;, and &quot;Showcase&quot; pages are defined in data and generated by the navigator. Try searching, double-clicking a row, right-clicking, and printing."
                   TextWrapping="Wrap" Margin="0,0,0,12"/>
        <WrapPanel>
            <Button Content="📦 Products" Command="{Binding OpenProductsCommand}"/>
            <Button Content="🛍 Showcase" Command="{Binding OpenShowcaseCommand}"/>
            <Button Content="＋ New product" Command="{Binding AddProductCommand}"/>
            <Button Content="ℹ About" Command="{Binding AboutCommand}"/>
        </WrapPanel>
    </StackPanel>
</UserControl>

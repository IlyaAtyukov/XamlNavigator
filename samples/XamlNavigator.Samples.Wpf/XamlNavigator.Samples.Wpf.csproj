<Project Sdk="Microsoft.NET.Sdk">

  <!-- Пример WPF: те же модели экранов, что и в MAUI-примере (XamlNavigator.Samples.Shared).
       Собирается и под .NET 8, и под .NET Framework 4.8. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <RootNamespace>XamlNavigator.Samples</RootNamespace>
    <AssemblyName>XamlNavigator.Samples.Wpf</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\XamlNavigator.Wpf\XamlNavigator.Wpf.csproj" />
    <ProjectReference Include="..\XamlNavigator.Samples.Shared\XamlNavigator.Samples.Shared.csproj" />
  </ItemGroup>

</Project>
